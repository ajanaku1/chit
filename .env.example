# Optional public RPC overrides
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
FORK_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Required only for live deployment scripts. Never commit a funded key.
DEPLOYER_PRIVATE_KEY=your-sepolia-test-key

# Required only when constructing the trusted operator service.
SERVICE_MASTER_SECRET=generate-a-random-32-byte-secret

# Optional deployment record used by the service checker.
CHIT_SERVICE_TARGET_PATH=deployments/low-stake-round.json

# Fleet service (Vercel). Tokens a sponsored buy may target, comma separated.
# Unset means any token; set it to the venue tokens the operator stands behind.
FLEET_TOKEN_ALLOWLIST=0x13283ab8e1f2bc4297e9ec6480c80c59674af554
# Slippage a sponsored buy tolerates against the pool's spot price, in basis
# points (200 = 2%). The buy is refused when no quote can be read.
FLEET_MAX_SLIPPAGE_BPS=200

# Separate secrets for the fleet service, so one leaked variable is not the
# custodian, the ledger and the nonce secret at once. Both default to a value
# derived from the operator key, which is how the live service runs today.
# FLEET_LEDGER_KEY: 32 bytes hex. Set it before the pool holds any draw, or
# never: changing it makes every sealed depositor reference unreadable.
# FLEET_NONCE_SECRET: any string of 32+ characters; rotating it only expires
# challenges in flight.
FLEET_LEDGER_KEY=
FLEET_NONCE_SECRET=

# The fleet service's shared store. Vercel runs the API as many instances;
# without this each keeps its own idempotency results, nonce burns and slice
# claims, so a retry that lands elsewhere can run twice. With it, Neon holds
# them and one operator lock serialises signing. Tables are created on first
# use. Absent means memory, with a warning at startup.
DATABASE_URL=

# The cold admin for the Stage 2 contracts: the address that can rotate the
# operator, unpause, name the guardian and claim gas, and nothing else. Read by
# the deploy scripts, which refuse to run without it and refuse the deployer's
# own address: a hot key that is its own admin can unpause itself. Ownership
# is offered two-step; the admin accepts with one acceptOwnership() per contract.
FLEET_ADMIN_ADDRESS=

# Optional. With it set, GET /api/fleet/sweep (the scheduled sweep, which
# queues charges in a batch) answers 401 unless the caller sends
# "Authorization: Bearer <CRON_SECRET>". Vercel's crons send it on their own;
# set the same value as the FLEET_CRON_SECRET repository secret so the GitHub
# Actions schedule can too. Unset means the endpoint is open, as before.
CRON_SECRET=
