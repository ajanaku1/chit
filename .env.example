# Optional public RPC overrides
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
FORK_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Required only for live deployment scripts. Never commit a funded key.
DEPLOYER_PRIVATE_KEY=your-sepolia-test-key

# Required only when constructing the trusted operator service.
SERVICE_MASTER_SECRET=generate-a-random-32-byte-secret

# Optional deployment record used by the service checker.
CHIT_SERVICE_TARGET_PATH=deployments/low-stake-round.json

# Fleet service (Vercel). Tokens a sponsored buy may target, comma separated.
# Unset means any token; set it to the venue tokens the operator stands behind.
FLEET_TOKEN_ALLOWLIST=0x13283ab8e1f2bc4297e9ec6480c80c59674af554
# Slippage a sponsored buy tolerates against the pool's spot price, in basis
# points (200 = 2%). The buy is refused when no quote can be read.
FLEET_MAX_SLIPPAGE_BPS=200

# Separate secrets for the fleet service, so one leaked variable is not the
# custodian, the ledger and the nonce secret at once. Both default to a value
# derived from the operator key, which is how the live service runs today.
# FLEET_LEDGER_KEY: 32 bytes hex. Set it before the pool holds any draw, or
# never: changing it makes every sealed depositor reference unreadable.
# FLEET_NONCE_SECRET: any string of 32+ characters; rotating it only expires
# challenges in flight.
FLEET_LEDGER_KEY=
FLEET_NONCE_SECRET=

# Chit Bot, the Telegram trading bot's testnet playground (docs/chit-bot.md).
# Served by api/bot.js on the same host; point Telegram at it once with
# scripts/bot-set-webhook.mjs. Testnet only: on mainnet the bot holds no keys.
TELEGRAM_BOT_TOKEN=
# 16+ characters, given to setWebhook and required on every update; without
# it the bot refuses to start.
TELEGRAM_WEBHOOK_SECRET=
BOT_USERNAME=
# Seals the playground keys at rest; 32+ characters with twelve distinct
# ones, never rotated once wallets exist (the canary would stop the bot).
BOT_KEY_SECRET=
# A throwaway key with test ETH that funds new wallets; never the operator's.
BOT_FAUCET_PRIVATE_KEY=
BOT_FAUCET_ETH=0.02
# The most the faucet pays out in a UTC day, across everyone.
BOT_FAUCET_DAILY_ETH=0.5
# The bot needs DATABASE_URL (Neon). One machine only (scripts/bot-poll.mjs): BOT_PGLITE_DIR keeps the same tables
# in a Postgres on disk so wallets survive a restart; BOT_MEMORY_STORE=1 keeps them in memory, gone when it stops.
BOT_PGLITE_DIR=
BOT_MEMORY_STORE=
# The Fleet card drives the hosted service at FLEET_ORIGIN; 1 hides it until the service is wired to the pool.
BOT_FLEET_OFF=
# Where the cards' banners are (default <FLEET_ORIGIN>/bot); a local folder on one machine; empty turns them off.
BOT_BANNER_BASE=
# 1 hides the share button; BOT_ASSET_DIR moves the share card's plate and fonts (default landing/public/bot).
BOT_SHARE_OFF=
BOT_ASSET_DIR=
# The fleet service's shared store. Vercel runs the API as many instances;
# without this each keeps its own idempotency results, nonce burns and slice
# claims, so a retry that lands elsewhere can run twice. With it, Neon holds
# them and one operator lock serialises signing. Tables are created on first
# use. Absent means memory, with a warning at startup.
DATABASE_URL=

# The cold admin for the Stage 2 contracts: the address that can rotate the
# operator, unpause, name the guardian and claim gas, and nothing else. Read by
# the deploy scripts, which refuse to run without it and refuse the deployer's
# own address: a hot key that is its own admin can unpause itself. Ownership
# is offered two-step; the admin accepts with one acceptOwnership() per contract.
FLEET_ADMIN_ADDRESS=

# Optional. With it set, GET /api/fleet/sweep (the scheduled sweep, which
# queues charges in a batch) answers 401 unless the caller sends
# "Authorization: Bearer <CRON_SECRET>". Vercel's crons send it on their own;
# set the same value as the FLEET_CRON_SECRET repository secret so the GitHub
# Actions schedule can too. Unset means the endpoint is open, as before.
CRON_SECRET=

# CHIT buyback and burn (docs/chit-buyback.md). The deployer key only pays
# the deploy gas; the contract has no owner. The keeper key is a throwaway
# with dust ETH that calls buyAndBurn when due (also a GitHub secret).
BUYBACK_DEPLOYER_KEY=
BUYBACK_KEEPER_KEY=
BUYBACK_ADDRESS=
# Immutable once deployed. Decided by the GC on 2026-09-16: these values (1% of the balance a call, 0.002 to 0.1 ETH, hourly, 5% under the quote).
BUYBACK_SPEND_BPS=100
BUYBACK_MIN_SPEND_ETH=0.002
BUYBACK_MAX_SPEND_ETH=0.1
BUYBACK_INTERVAL_SECONDS=3600
BUYBACK_MAX_SLIP_BPS=500

# Gas sponsorship for dapps (docs/gas-sponsorship.md). The set is deployed by
# `npm run sponsor-deploy:live`, which prints the two addresses. DATABASE_URL
# is the Neon connection string; the sponsor ledger (policies, daily caps,
# every sponsored op) lives there so the caps hold across function instances.
# Without it the route runs on a memory store and warns.
FLEET_SPONSOR_PAYMASTER_ADDRESS=
FLEET_SPONSOR_ESCROW_ADDRESS=
# The sponsor route's own signing key: an account of its own, never the pool
# operator's (the route refuses the operator's key under this name). Unset on
# testnet, the route still signs with the operator's key and warns, because
# the sponsor set deployed there names the operator; on mainnet sponsorship
# is off whatever is set.
FLEET_SPONSOR_PRIVATE_KEY=

# The chain the service runs on: 46630 (Robinhood Chain testnet, default) or
# 4663 (Robinhood Chain mainnet, the capped beta). On any chain but 46630
# every FLEET_*_ADDRESS must be set; nothing is assumed. FLEET_RPC_URL wins
# over ROBINHOOD_TESTNET_RPC_URL; both default by chain.
# FLEET_ESCROW_BLOCK is the block that mined the escrow, so the fleet list
# scans events from there and not from genesis.
FLEET_CHAIN_ID=46630
FLEET_RPC_URL=
FLEET_ESCROW_BLOCK=
# Deploy-time caps for `npm run fleet-redeploy:live`, in ETH; unset means the
# chain's published set (testnet 0.5 / 0.2 / 5, mainnet beta 0.1 / 0.05 / 1).
FLEET_DEPOSITOR_CAP_ETH=
FLEET_DRAW_CAP_ETH=
FLEET_POOL_CAP_ETH=
# A second key that can only pause the pool; required for a mainnet deploy.
FLEET_GUARDIAN_ADDRESS=
