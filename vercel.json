{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix app ci",
  "buildCommand": "npm run build && node scripts/assemble-site.mjs",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/bot.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/fleet/sweep", "schedule": "0 3 * * *" },
    { "path": "/api/fleet/sweep", "schedule": "0 15 * * *" }
  ]
}
