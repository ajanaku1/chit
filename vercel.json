{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix app ci",
  "buildCommand": "npm run build && node scripts/assemble-site.mjs",
  "outputDirectory": "public",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "functions": {
    "api/bot.js": {
      "maxDuration": 60,
      "includeFiles": "landing/public/bot/**"
    },
    "api/buyback/keeper.js": {
      "maxDuration": 180
    },
    "api/bot/orders.js": {
      "maxDuration": 300
    },
    "api/bot/watch.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/fleet/sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/fleet/sweep",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/buyback/keeper",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/bot/orders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/bot/watch",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/fleet.html",
      "permanent": false
    }
  ]
}
