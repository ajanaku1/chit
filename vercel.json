{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix app ci",
  "buildCommand": "npm run build && node scripts/assemble-site.mjs",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/bot.js": {
      "maxDuration": 60,
      "includeFiles": "landing/public/bot/**"
    },
    "api/buyback/keep.js": {
      "maxDuration": 180,
      "includeFiles": "scripts/buyback-keeper.mjs"
    }
  },
  "crons": [
    {
      "path": "/api/fleet/sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/fleet/sweep",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/buyback/keep",
      "schedule": "5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/fleet.html",
      "permanent": false
    }
  ]
}
