{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix app ci",
  "buildCommand": "npm run build && node scripts/assemble-site.mjs",
  "outputDirectory": "public",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "functions": {
    "api/bot.js": {
      "maxDuration": 60,
      "includeFiles": "landing/public/bot/**"
    },
    "api/buyback/keeper.js": {
      "maxDuration": 180
    },
    "api/bot/orders.js": {
      "maxDuration": 300
    },
    "api/bot/watch.js": {
      "maxDuration": 300
    },
    "api/fleet/balance.js": {
      "maxDuration": 60
    },
    "api/fleet/buy.js": {
      "maxDuration": 60
    },
    "api/fleet/campaign.js": {
      "maxDuration": 60
    },
    "api/fleet/control.js": {
      "maxDuration": 60
    },
    "api/fleet/sponsor.js": {
      "maxDuration": 180
    },
    "api/fleet/sweep-posting.js": {
      "maxDuration": 180
    },
    "api/fleet/sweep.js": {
      "maxDuration": 180
    },
    "api/fleet/trade.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/fleet/sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/fleet/sweep",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/fleet/sweep-posting",
      "schedule": "45 */2 * * *"
    },
    {
      "path": "/api/buyback/keeper",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/bot/orders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/bot/watch",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://chit.tools",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/app/balance",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/(balance|fleet|fleet-dashboard|fleet-privacy|sessions|trade)",
      "destination": "/app/$1.html"
    }
  ]
}
